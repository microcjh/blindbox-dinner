/* pages/invitation/invitation.wxss — 邀请好友分享页 */
.invite {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Hero */
.invite__hero {
  padding: 40rpx 32rpx 36rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFF1EA 0%, #FFE3D6 100%);
  border-radius: var(--radius-card, 24rpx);
}
.invite__hero-emoji {
  font-size: 72rpx;
  line-height: 1;
}
.invite__hero-title {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #FF6B4A;
}
.invite__hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-sub, #8A8A8A);
  line-height: 1.5;
}

/* 邀请人身份 */
.identity {
  display: flex;
  align-items: center;
}
.identity__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFE3D6;
  flex-shrink: 0;
}
.identity__avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FF6B4A;
  font-size: 36rpx;
  font-weight: 600;
}
.identity__info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.identity__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #1A1A1A);
}
.identity__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-sub, #8A8A8A);
}

/* 分享方式列表 */
.ways {
  display: flex;
  flex-direction: column;
}
.way {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border, #EEE);
}
.way:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.way__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #FFF1EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.way__body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.way__title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text, #1A1A1A);
}
.way__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-sub, #8A8A8A);
  line-height: 1.4;
}

/* 分享记录 */
.records__empty {
  font-size: 24rpx;
  color: var(--color-text-sub, #8A8A8A);
  text-align: center;
  padding: 24rpx 0;
}
.records {
  display: flex;
  flex-direction: column;
}
.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border, #EEE);
}
.record:last-child {
  border-bottom: none;
}
.record__type {
  font-size: 26rpx;
  color: var(--color-text, #1A1A1A);
}
.record__time {
  font-size: 22rpx;
  color: var(--color-text-sub, #8A8A8A);
}
