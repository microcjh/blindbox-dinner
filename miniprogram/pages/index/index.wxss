/* pages/index/index.wxss — 场次列表 */
.list {
  min-height: 100vh;
  padding: 0 0 calc(32rpx + env(safe-area-inset-bottom));
}

/* 区筛选 chips */
.chips {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  display: flex;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--color-surface);
  color: var(--color-text-sub);
  font-size: 26rpx;
  box-shadow: var(--shadow-card);
}
.chip--active {
  background: var(--color-primary);
  color: #fff;
}

/* 列表主体 */
.list__body {
  padding: 8rpx 24rpx 0;
}
.card {
  margin-bottom: 20rpx;
  border-radius: var(--radius-card);
}
.ev {
  padding: 4rpx 8rpx;
}
.ev__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ev__loc {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.ev__time {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-secondary);
  letter-spacing: 1rpx;
}
.ev__bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.ev__price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.ev__price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-sub);
  margin-left: 4rpx;
}
.ev__seats {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

/* 触底加载提示 */
.list__more {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 24rpx;
  padding: 24rpx 0;
}
