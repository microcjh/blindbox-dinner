/* pages/event-detail/event-detail.wxss */
.detail {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* 主信息区 */
.hero {
  background: linear-gradient(135deg, #FF6B4A 0%, #FF8A5B 100%);
  border-radius: var(--radius-card);
  padding: 40rpx 32rpx;
  color: #fff;
  box-shadow: var(--shadow-card);
}
.hero__loc {
  font-size: 28rpx;
  opacity: 0.92;
}
.hero__time {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero__price {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}
.hero__price-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 6rpx;
  opacity: 0.9;
}
.hero__seats {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
}
.hero__seats--full {
  color: #FFE0D6;
}

/* 卡片间距 */
.detail ui-card {
  display: block;
  margin-top: 20rpx;
  border-radius: var(--radius-card);
}

/* 餐厅 */
.rest__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.rest__tags {
  margin-top: 12rpx;
  display: flex;
}
.rest__tags ui-tag {
  margin-right: 12rpx;
}
.rest__addr {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}
.rest__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-sub);
}

/* 须知 */
.note__item {
  font-size: 26rpx;
  color: var(--color-text-sub);
  line-height: 1.9;
}

/* 饭后沉淀 */
.table__tip {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-bottom: 16rpx;
}
.table__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.table__row:first-of-type {
  border-top: none;
}
.table__name {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}
.table__actions {
  display: flex;
}
.table__actions ui-button {
  margin-left: 12rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 28rpx;
  text-align: center;
}
.sheet__textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  margin-bottom: 28rpx;
  background: #fafafa;
}
.sheet ui-button {
  margin-top: 16rpx;
}

/* 评分星星 */
.stars {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}
.star {
  font-size: 64rpx;
  color: #d8d8d8;
  margin: 0 10rpx;
  transition: color 0.15s;
}
.star--on {
  color: #FFB400;
}

/* 一键 SOS 浮标 */
.sos-fab {
  position: fixed;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 50;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e54d42;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(229, 77, 66, 0.4);
}
.sos-fab--hover {
  opacity: 0.85;
  transform: scale(0.94);
}

/* 饭后沉淀 → 查看全部评价入口 */
.table__more {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 26rpx;
  color: #FF6B4A;
}
.table__more-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
}
