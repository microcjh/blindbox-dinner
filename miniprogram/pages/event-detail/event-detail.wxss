/* pages/event-detail/event-detail.wxss */
.detail {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* 主信息区 */
.hero {
  background: linear-gradient(135deg, #FF6B4A 0%, #FF8A5B 100%);
  border-radius: var(--radius-card);
  padding: 40rpx 32rpx;
  color: #fff;
  box-shadow: var(--shadow-card);
}
.hero__loc {
  font-size: 28rpx;
  opacity: 0.92;
}
.hero__time {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero__price {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}
.hero__price-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 6rpx;
  opacity: 0.9;
}
.hero__seats {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
}
.hero__seats--full {
  color: #FFE0D6;
}

/* 卡片间距 */
.detail ui-card {
  display: block;
  margin-top: 20rpx;
  border-radius: var(--radius-card);
}

/* 餐厅 */
.rest__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.rest__tags {
  margin-top: 12rpx;
  display: flex;
}
.rest__tags ui-tag {
  margin-right: 12rpx;
}
.rest__addr {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}
.rest__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-sub);
}

/* 须知 */
.note__item {
  font-size: 26rpx;
  color: var(--color-text-sub);
  line-height: 1.9;
}
