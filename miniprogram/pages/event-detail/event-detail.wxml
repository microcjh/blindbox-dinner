<!-- pages/event-detail/event-detail.wxml — 场次详情 + 报名 -->
<view class="detail">

  <!-- 一键 SOS 浮标（饭局中安全兜底，任何已登录用户可用） -->
  <view
    wx:if="{{!loading && !notFound}}"
    class="sos-fab"
    hover-class="sos-fab--hover"
    bind:tap="onSos"
  >SOS</view>

  <skeleton wx:if="{{loading}}" loading="{{true}}" rows="{{4}}" />

  <block wx:elif="{{!notFound}}">
    <!-- 主信息 -->
    <view class="hero">
      <view class="hero__loc">{{event.city}} · {{event.district}}</view>
      <view class="hero__time">{{timeText}}</view>
      <view class="hero__price">{{priceText}}<text class="hero__price-unit">/人</text></view>
      <view class="hero__seats {{isFull ? 'hero__seats--full' : ''}}">已报名 {{seatsText}} 人</view>
    </view>

    <!-- 餐厅信息 -->
    <ui-card wx:if="{{restaurant}}" title="餐厅信息">
      <view class="rest">
        <view class="rest__name">{{restaurant.name}}</view>
        <view class="rest__tags">
          <ui-tag type="secondary" plain small>{{restaurant.cuisine}}</ui-tag>
          <ui-tag type="trust" plain small wx:if="{{restaurant.verified}}">已认证</ui-tag>
        </view>
        <view class="rest__addr">{{restaurant.address}}</view>
        <view class="rest__meta">人均 {{priceText}} · 评分 {{restaurant.rating}}</view>
      </view>
    </ui-card>

    <!-- 约饭须知 -->
    <ui-card title="约饭须知">
      <view class="note">
        <view class="note__item">· 强实名约饭，到场请配合身份核验</view>
        <view class="note__item">· 报名后席位锁定，餐费现场 AA</view>
        <view class="note__item">· 饭局中如遇不适，可一键 SOS</view>
      </view>
    </ui-card>

    <!-- 饭后沉淀：仅本场已凑桌成员可见 -->
    <ui-card wx:if="{{isTableMember}}" title="饭后沉淀">
      <view class="table">
        <view class="table__tip">饭局结束啦，给同桌饭友一个评价吧（不可跨桌）</view>
        <view class="table__row" wx:for="{{tableMembers}}" wx:key="uid">
          <view class="table__name">{{item.name}}</view>
          <view class="table__actions">
            <ui-button size="small" type="ghost" data-uid="{{item.uid}}" data-name="{{item.name}}" bind:tap="onOpenReview">评价</ui-button>
            <ui-button size="small" type="ghost" data-uid="{{item.uid}}" data-name="{{item.name}}" bind:tap="onOpenReport">举报</ui-button>
          </view>
        </view>
        <view class="table__more" bind:tap="goReview">
          <text>查看全部评价</text>
          <text class="table__more-arrow">›</text>
        </view>
      </view>
    </ui-card>
  </block>

  <empty wx:else icon="🍽️" text="场次不存在或已结束" desc="换个场次看看吧" />

  <!-- 吸底操作条 -->
  <bottom-bar bordered wx:if="{{!loading && !notFound}}">
    <ui-button
      wx:if="{{!registered}}"
      type="primary"
      block
      size="large"
      loading="{{registering}}"
      disabled="{{registering || isFull}}"
      bind:tap="onRegister"
    >{{isFull ? '名额已满' : '立即报名'}}</ui-button>
    <ui-button
      wx:else
      type="ghost"
      block
      size="large"
      loading="{{registering}}"
      disabled="{{registering}}"
      bind:tap="onUnregister"
    >取消报名</ui-button>
  </bottom-bar>

  <!-- 评价弹层 -->
  <view wx:if="{{reviewPanel.open}}" class="mask" bind:tap="onCloseReview">
    <view class="sheet" catch:tap="noop">
      <view class="sheet__title">评价 {{reviewPanel.toName}}</view>
      <view class="stars">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star {{item <= reviewPanel.score ? 'star--on' : ''}}"
          data-score="{{item}}"
          bind:tap="onPickScore"
        >★</text>
      </view>
      <ui-button
        type="primary"
        block
        size="large"
        loading="{{reviewPanel.submitting}}"
        disabled="{{reviewPanel.submitting}}"
        bind:tap="onSubmitReview"
      >提交评价</ui-button>
      <ui-button size="large" bind:tap="onCloseReview">取消</ui-button>
    </view>
  </view>

  <!-- 举报弹层 -->
  <view wx:if="{{reportPanel.open}}" class="mask" bind:tap="onCloseReport">
    <view class="sheet" catch:tap="noop">
      <view class="sheet__title">举报 {{reportTargetName}}</view>
      <textarea
        class="sheet__textarea"
        placeholder="请描述举报原因（如言语冒犯、骚扰等）"
        value="{{reportPanel.reason}}"
        maxlength="50"
        bindinput="onReportReasonInput"
      />
      <ui-button
        type="primary"
        block
        size="large"
        loading="{{reportPanel.submitting}}"
        disabled="{{reportPanel.submitting}}"
        bind:tap="onSubmitReport"
      >提交举报</ui-button>
      <ui-button size="large" bind:tap="onCloseReport">取消</ui-button>
    </view>
  </view>

</view>
