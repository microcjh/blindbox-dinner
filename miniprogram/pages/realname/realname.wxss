/* pages/realname/realname.wxss */
.realname {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 16rpx 8rpx 28rpx;
}
.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1f1f;
  line-height: 1.2;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.5;
}

.field {
  margin-bottom: 28rpx;
}
.field__label {
  display: block;
  font-size: 26rpx;
  color: #4a4a4a;
  margin-bottom: 12rpx;
}
.field__input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1f1f1f;
}
.field__ph {
  color: #b5b5b5;
}

.privacy {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #b5b5b5;
  line-height: 1.5;
}

.verified__tip {
  font-size: 26rpx;
  color: #4a4a4a;
  line-height: 1.6;
  margin-bottom: 28rpx;
}
