.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.field {
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #1a1a1a;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 28rpx;
  background: #f6f7fb;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
  border: 1rpx solid transparent;
  transition: all 0.15s;
}
.chip-on {
  background: rgba(255, 107, 74, 0.12);
  color: #ff6b4a;
  border-color: #ff6b4a;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff6b4a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
.submit-btn[disabled] {
  opacity: 0.6;
}
