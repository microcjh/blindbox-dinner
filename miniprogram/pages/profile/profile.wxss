/* profile — 我的报名（"我的" tab） */
.profile {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

/* 头部概览 */
.profile__header {
  display: flex;
  align-items: center;
  padding: var(--space-4) var(--space-2);
  margin-bottom: var(--space-4);
}

.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: var(--space-3);
}

.profile__meta {
  display: flex;
  flex-direction: column;
}

.profile__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.profile__sub {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 4rpx;
}

/* 列表 */
.profile__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* 报名卡片 */
.reg-card {
  background: var(--color-surface);
}

.reg-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reg-card__loc {
  display: flex;
  align-items: baseline;
}

.reg-card__city {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.reg-card__district {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-left: 4rpx;
}

.reg-card__time {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-top: var(--space-2);
}

.reg-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3);
}

.reg-card__price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.reg-card__seats {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.reg-card__pay {
  margin-top: var(--space-3);
}

/* 我的桌区块（task-025） */
.tables {
  margin-top: var(--space-5);
}

.tables__head {
  display: flex;
  align-items: baseline;
  margin-bottom: var(--space-3);
  padding: 0 var(--space-1);
}

.tables__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.tables__hint {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-left: var(--space-2);
}

.tables__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.table-card {
  background: var(--color-surface);
}

.table-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-card__score {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.1;
}

.table-card__score-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.table-card__score-label {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-top: 2rpx;
}

/* 同频分构成进度条（task-027） */
.table-card__breakdown {
  margin-top: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.bk-row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.bk-label {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--color-text-sub);
}

.bk-track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--color-bg);
  overflow: hidden;
  margin: 0 var(--space-2);
}

.bk-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-warning));
  transition: width 0.3s ease;
}

.bk-value {
  width: 48rpx;
  flex-shrink: 0;
  text-align: right;
  color: var(--color-text);
  font-weight: 600;
}

.tables__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-5) var(--space-3);
}

.tables__empty-text {
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.tables__empty-sub {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: var(--space-2);
}
