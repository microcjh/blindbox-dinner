<view class="profile">
  <!-- 头部：用户态概览 -->
  <view class="profile__header">
    <view class="profile__avatar" aria-hidden="true">🍽️</view>
    <view class="profile__meta">
      <text class="profile__title">我的饭局</text>
      <text class="profile__sub">{{loggedIn ? (isVerified ? '已实名 · 放心约饭' : '未实名 · 报名前需认证') : '登录后查看你的报名'}}</text>
    </view>
  </view>

  <!-- 未登录：引导 -->
  <ui-empty
    wx:if="{{notFound}}"
    icon="👋"
    text="你还没有登录"
    desc="登录后即可查看你的盲盒饭局"
    show-action="{{true}}"
  >
    <ui-button slot="action" type="primary" size="large" block="{{true}}" bind:tap="goLogin">去登录</ui-button>
  </ui-empty>

  <!-- 已登录：骨架 / 列表 / 空 -->
  <block wx:else>
    <ui-skeleton loading="{{loading}}" title="{{true}}" row-array="{{[100, 80, 60]}}">
      <view wx:if="{{rows.length === 0 && !loading}}" class="profile__list">
        <ui-empty
          icon="🍜"
          text="还没有报名任何饭局"
          desc="去「场次」挑一场盲盒约饭吧"
          show-action="{{true}}"
        >
          <ui-button slot="action" type="primary" size="large" block="{{true}}" bind:tap="goList">去逛逛</ui-button>
        </ui-empty>
      </view>

      <view wx:else class="profile__list">
        <ui-card
          wx:for="{{rows}}"
          wx:key="regId"
          class="reg-card"
          padding="24rpx"
          data-id="{{item.eventId}}"
          bind:tap="goDetail"
        >
          <view class="reg-card__top">
            <view class="reg-card__loc">
              <text class="reg-card__city">{{item.city}}</text>
              <text class="reg-card__district" wx:if="{{item.district}}">· {{item.district}}</text>
            </view>
            <ui-tag type="{{item.state === 'unpaid' ? 'warning' : 'success'}}" small="{{true}}" plain="{{true}}">
              {{item.stateText}}
            </ui-tag>
          </view>

          <view class="reg-card__time">{{item.timeText}}</view>

          <view class="reg-card__foot">
            <text class="reg-card__price">{{item.priceText}}</text>
            <text class="reg-card__seats">已报名 {{item.seatsText}}</text>
          </view>

          <ui-button
            wx:if="{{item.canPay}}"
            slot="footer"
            class="reg-card__pay"
            type="primary"
            size="small"
            block="{{true}}"
            loading="{{payingId === item.eventId}}"
            data-id="{{item.eventId}}"
            catchtap="onContinuePay"
          >继续支付</ui-button>

          <ui-button
            wx:if="{{item.canRefund}}"
            slot="footer"
            class="reg-card__refund"
            type="ghost"
            size="small"
            block="{{true}}"
            loading="{{refundingId === item.eventId}}"
            data-id="{{item.eventId}}"
            catchtap="onRefund"
          >申请退款</ui-button>
        </ui-card>
      </view>
    </ui-skeleton>

    <!-- 我的桌：凑桌成功的同频饭局（task-025） -->
    <view class="tables">
      <view class="tables__head">
        <text class="tables__title">我的桌</text>
        <text class="tables__hint">系统为你凑的同频饭局</text>
      </view>

      <ui-skeleton loading="{{tablesLoading}}" title="{{false}}" row-array="{{[100, 40]}}">
        <view wx:if="{{tables.length === 0 && !tablesLoading}}" class="tables__empty">
          <text class="tables__empty-text">还没有凑桌成功的饭局</text>
          <text class="tables__empty-sub">报名并支付后，满 4 人即自动成桌</text>
        </view>

        <view wx:else class="tables__list">
          <ui-card
            wx:for="{{tables}}"
            wx:key="id"
            class="table-card"
            padding="24rpx"
            data-id="{{item.eventId}}"
            bind:tap="goDetail"
          >
            <view class="table-card__top">
              <view class="reg-card__loc">
                <text class="reg-card__city">{{item.city}}</text>
                <text class="reg-card__district" wx:if="{{item.district}}">· {{item.district}}</text>
              </view>
              <view class="table-card__score" wx:if="{{item.scoreValue !== null}}">
                <text class="table-card__score-num">{{item.scoreValue}}</text>
                <text class="table-card__score-label">{{item.scoreLabel}}</text>
              </view>
            </view>

            <view class="reg-card__time">{{item.timeText}}</view>

            <view class="reg-card__foot">
              <text class="reg-card__price">{{item.priceText}}</text>
              <text class="reg-card__seats">{{item.memberCount}} 人同桌</text>
            </view>

            <view class="table-card__breakdown" wx:if="{{item.breakdownList}}">
              <view class="bk-row" wx:for="{{item.breakdownList}}" wx:key="label" wx:for-item="bk">
                <text class="bk-label">{{bk.label}}</text>
                <view class="bk-track"><view class="bk-fill" style="width:{{bk.value}}%"></view></view>
                <text class="bk-value">{{bk.value}}</text>
              </view>
            </view>
          </ui-card>
        </view>
      </ui-skeleton>
    </view>
  </block>
</view>
