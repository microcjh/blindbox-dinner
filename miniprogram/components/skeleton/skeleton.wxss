/* skeleton.wxss — 加载骨架屏 */
.ui-skeleton {
  display: flex;
  box-sizing: border-box;
}

.ui-skeleton__avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
  background-size: 400% 100%;
  animation: ui-skeleton-shine 1.4s ease infinite;
}

.ui-skeleton__main {
  flex: 1;
  min-width: 0;
}

.ui-skeleton__title {
  height: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
  background-size: 400% 100%;
  animation: ui-skeleton-shine 1.4s ease infinite;
}

.ui-skeleton__row {
  height: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
  background-size: 400% 100%;
  animation: ui-skeleton-shine 1.4s ease infinite;
}

.ui-skeleton__row:last-child {
  margin-bottom: 0;
}

@keyframes ui-skeleton-shine {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
